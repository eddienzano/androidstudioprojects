<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================================================= -->
    <!-- PRESSED -->
    <!-- ========================================================= -->

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="#315B44" />

            <corners
                android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#315B44" />

        </shape>

    </item>


    <!-- ========================================================= -->
    <!-- DISABLED -->
    <!-- ========================================================= -->

    <item android:state_enabled="false">

        <shape android:shape="rectangle">

            <solid android:color="#D7E1DA" />

            <corners
                android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#C8D4CC" />

        </shape>

    </item>


    <!-- ========================================================= -->
    <!-- NORMAL -->
    <!-- ========================================================= -->

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#4E8A65" />

            <corners
                android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#4E8A65" />

        </shape>

    </item>

</selector>