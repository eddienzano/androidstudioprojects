<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PRESSED -->

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="#245238" />

            <corners android:radius="15dp" />

            <stroke
                android:width="1dp"
                android:color="#2E6947" />

        </shape>

    </item>


    <!-- DISABLED -->

    <item android:state_enabled="false">

        <shape android:shape="rectangle">

            <solid android:color="#B8C8BD" />

            <corners android:radius="15dp" />

        </shape>

    </item>


    <!-- NORMAL -->

    <item>

        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#356F4D"
                android:endColor="#285C40" />

            <corners android:radius="15dp" />

            <stroke
                android:width="1dp"
                android:color="#42795A" />

        </shape>

    </item>

</selector>