<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- FOCUSED -->

    <item android:state_focused="true">

        <shape android:shape="rectangle">

            <corners
                android:radius="15dp" />

            <solid
                android:color="#F8FCF9" />

            <stroke
                android:width="2dp"
                android:color="#5C9B73" />

        </shape>

    </item>


    <!-- NORMAL -->

    <item>

        <shape android:shape="rectangle">

            <corners
                android:radius="15dp" />

            <solid
                android:color="#F7F9F7" />

            <stroke
                android:width="1dp"
                android:color="#DCE6DF" />

        </shape>

    </item>

</selector>