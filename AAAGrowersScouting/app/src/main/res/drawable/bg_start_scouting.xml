<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="#155C32" />

            <corners android:radius="18dp" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#1F7A45" />

            <corners android:radius="18dp" />

            <stroke
                android:width="1dp"
                android:color="#3C9360" />

            <padding
                android:left="20dp"
                android:top="16dp"
                android:right="20dp"
                android:bottom="16dp" />

        </shape>

    </item>

</selector>