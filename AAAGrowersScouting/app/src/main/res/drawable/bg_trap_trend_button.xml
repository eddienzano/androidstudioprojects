<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SELECTED -->

    <item android:state_selected="true">

        <shape android:shape="rectangle">

            <solid android:color="#315B43" />

            <corners android:radius="12dp" />

            <stroke
                android:width="1dp"
                android:color="#315B43" />

        </shape>

    </item>


    <!-- PRESSED -->

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="#E3EFE6" />

            <corners android:radius="12dp" />

            <stroke
                android:width="1dp"
                android:color="#BFD5C5" />

        </shape>

    </item>


    <!-- NORMAL -->

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#F8FAF8" />

            <corners android:radius="12dp" />

            <stroke
                android:width="1dp"
                android:color="#DCE6DF" />

        </shape>

    </item>

</selector>