<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7F2"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:paddingBottom="36dp">


        <!-- ============================================================
             TOP BAR
             ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIELD SCOUTING"
                    android:textColor="#3C7A49"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Start Scouting"
                    android:textColor="#173620"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- BACK -->

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="BACK"
                android:textColor="#3C7A49"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:backgroundTint="#E5EEE7"
                android:elevation="1dp" />

        </LinearLayout>


        <!-- ============================================================
             WELCOME / SCOUT CARD
             ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="#183620"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY FOR A FIELD ROUND?"
                android:textColor="#BFD8C4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:id="@+id/scoutName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Field Scout"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Select the section you are about to inspect. Your scouting round will be saved locally on this device."
                android:textColor="#C5DCC9"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>


        <!-- ============================================================
             ROUND TYPE / STATUS
             ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:background="#3D8B4E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE SCOUTING"
                    android:textColor="#2E6B3E"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ready to create a local scouting round"
                    android:textColor="#778179"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ============================================================
             SECTION SELECTION CARD
             ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:elevation="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCOUTING SECTION"
                android:textColor="#6C776F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Where are you scouting?"
                android:textColor="#203327"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Choose the section that will be inspected during this round."
                android:textColor="#7A837C"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />


            <!-- SECTION LABEL -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="AVAILABLE SECTIONS"
                android:textColor="#879188"
                android:textSize="10sp"
                android:textStyle="bold" />


            <!-- SECTION SPINNER -->

            <Spinner
                android:id="@+id/sectionSpinner"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:minHeight="58dp"
                android:background="@android:drawable/editbox_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />


            <!-- SECTION STATUS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#6FA579" />

                <TextView
                    android:id="@+id/sectionStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Loading sections..."
                    android:textColor="#667169"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ============================================================
             WHAT HAPPENS NEXT
             ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="19dp"
            android:background="#E8F1EA"
            android:elevation="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WHAT HAPPENS NEXT"
                android:textColor="#2E6B3E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="vertical">

                <!-- STEP 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="#3C7A49" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="11dp"
                        android:text="Create the scouting round"
                        android:textColor="#27402E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- STEP 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="#3C7A49" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="11dp"
                        android:text="Select scanning points"
                        android:textColor="#27402E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- STEP 3 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="#3C7A49" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="11dp"
                        android:text="Record field observations"
                        android:textColor="#27402E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- STEP 4 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="#3C7A49" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="11dp"
                        android:text="Complete the scouting round"
                        android:textColor="#27402E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ============================================================
             START BUTTON
             ============================================================ -->

        <Button
            android:id="@+id/startScoutingButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="START SCOUTING"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:backgroundTint="#2E6B3E"
            android:elevation="7dp" />


        <!-- ============================================================
             FOOTER
             ============================================================ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Your scouting data will be stored locally and can be synchronized later."
            android:textColor="#89938B"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />


        <View
            android:layout_width="match_parent"
            android:layout_height="18dp" />

    </LinearLayout>

</ScrollView>

