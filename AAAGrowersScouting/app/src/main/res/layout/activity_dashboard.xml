<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7F4"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="30dp">


        <!-- ========================================================= -->
        <!-- TOP BRAND -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:background="@drawable/bg_brand_mark">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AAA GROWERS"
                    android:textColor="#173A2A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="FIELD INTELLIGENCE"
                    android:textColor="#668273"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />

            </LinearLayout>


            <!-- ONLINE -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_online_badge">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#4E9A69"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="ONLINE"
                    android:textColor="#47735A"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- WELCOME -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIELD SCOUTING"
                android:textColor="#588069"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

            <TextView
                android:id="@+id/welcomeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Welcome back"
                android:textColor="#173326"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/usernameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="scout"
                android:textColor="#789084"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- MASTER DATA -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_stat_card">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIELD DATA"
                        android:textColor="#588069"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14" />


                    <TextView
                        android:id="@+id/masterDataStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="MASTER DATA NOT SYNCHRONIZED"
                        android:textColor="#173326"
                        android:textSize="13sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/masterDataLastSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Sync before starting a scouting round."
                        android:textColor="#789084"
                        android:textSize="10sp" />

                </LinearLayout>


                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="#315B44"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <Button
                android:id="@+id/syncMasterDataButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dashboard_button"
                android:clickable="true"
                android:enabled="true"
                android:focusable="true"
                android:stateListAnimator="@null"
                android:text="SYNC MASTER DATA"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- START SCOUTING CARD -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_start_scouting"
            android:elevation="7dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY FOR THE FIELD?"
                android:textColor="#B9E3C5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.13" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Start a new scouting round"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Walk the field, capture observations and mark severe points as you go."
                android:textColor="#D4E8D9"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />


            <Button
                android:id="@+id/startScoutingButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_dashboard_button"
                android:stateListAnimator="@null"
                android:text="START SCOUTING     →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <Button
                android:id="@+id/syncToServerButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SEND TO SERVER"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- TRAP MONITORING CARD -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_stat_card"
            android:elevation="3dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PEST MONITORING"
                android:textColor="#588069"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.13" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Trap monitoring"
                android:textColor="#173326"
                android:textSize="21sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Scan a trap QR code to record FCM and General Moth observations."
                android:textColor="#718378"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />


            <Button
                android:id="@+id/trapMonitoringButton1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dashboard_button"
                android:stateListAnimator="@null"
                android:text="OPEN TRAP MONITORING     →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <Button
                android:id="@+id/syncTrapObservationsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dashboard_button"
                android:stateListAnimator="@null"
                android:text="SYNC TRAP OBSERVATIONS     ↻"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- TODAY -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="TODAY"
            android:textColor="#588069"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <!-- POINTS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_stat_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#173326"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Scanning Points"
                    android:textColor="#718378"
                    android:textSize="11sp" />

            </LinearLayout>


            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />


            <!-- SEVERE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_stat_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#A84B4B"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Severe Points"
                    android:textColor="#718378"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- PROFILE -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_profile_card">


            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:background="@drawable/bg_profile_avatar">

                <TextView
                    android:id="@+id/profileInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/roleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIELD SCOUT"
                    android:textColor="#315B44"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Authenticated session"
                    android:textColor="#87978D"
                    android:textSize="10sp" />

            </LinearLayout>


            <Button
                android:id="@+id/logoutButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="#A65353"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- FOOTER -->
        <!-- ========================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="25dp"
            android:text="AAA GROWERS • SCOUTING"
            android:textColor="#9AAA9F"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

    </LinearLayout>

</ScrollView>