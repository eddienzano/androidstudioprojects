<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0D47A1"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏭 Packhouse Reports"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generate verified intake PDF reports"
                android:textColor="#DDE8FF"
                android:layout_marginTop="5dp"/>
        </LinearLayout>

        <!-- FILTER CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:orientation="vertical"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:text="Filter Report"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="10dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <!-- FARM -->
            <TextView
                android:text="Farm"
                android:textColor="#777777"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <Spinner
                android:id="@+id/spFarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"/>

            <!-- FROM DATE -->
            <TextView
                android:text="From Date"
                android:textColor="#777777"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <EditText
                android:id="@+id/txtFrom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select start date"
                android:focusable="false"
                android:padding="12dp"
                android:background="#F1F3F6"
                android:layout_marginBottom="15dp"/>

            <!-- TO DATE -->
            <TextView
                android:text="To Date"
                android:textColor="#777777"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <EditText
                android:id="@+id/txtTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select end date"
                android:focusable="false"
                android:padding="12dp"
                android:background="#F1F3F6"/>
        </LinearLayout>

        <!-- ACTION BUTTON CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="4dp">

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📥 Generate And Download PDF"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"/>

            <!-- PROGRESS -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="15dp"/>

            <!-- OPEN BUTTON -->
            <Button
                android:id="@+id/btnOpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📄 Open Report"
                android:visibility="gone"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>