<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5">

    <!-- ========================================================= -->
    <!-- ROOT CONTENT -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===================================================== -->
        <!-- PREMIUM HEADER -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="#1B5E20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:contentDescription="Back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Summer Rejection"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Quality control &amp; rejection recording"
                        android:textColor="#C8E6C9"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- MAIN SCROLL AREA -->
        <!-- ===================================================== -->

        <androidx.core.widget.NestedScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp">


                <!-- ================================================= -->
                <!-- STAGE 1 : SELECTION -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/selectionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Intro -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Record a rejection"
                        android:textColor="#263238"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Select the farm, flower type and variety before recording rejected stems."
                        android:textColor="#718096"
                        android:textSize="14sp"/>


                    <!-- ================================================= -->
                    <!-- FARM CARD -->
                    <!-- ================================================= -->

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FARM"
                                android:textColor="#78909C"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:gravity="center"
                                    android:text="🌱"
                                    android:textSize="20sp"
                                    android:background="#E8F5E9"/>

                                <Spinner
                                    android:id="@+id/spinnerFarm"
                                    android:layout_width="0dp"
                                    android:layout_height="50dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:backgroundTint="#2E7D32"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"/>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- ================================================= -->
                    <!-- FLOWER TYPE CARD -->
                    <!-- ================================================= -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFlowerType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FLOWER TYPE"
                                android:textColor="#78909C"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"/>

                            <Spinner
                                android:id="@+id/spinnerFlowerType"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="8dp"
                                android:backgroundTint="#2E7D32"
                                android:enabled="false"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- ================================================= -->
                    <!-- VARIETY CARD -->
                    <!-- ================================================= -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardVariety"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VARIETY"
                                android:textColor="#78909C"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"/>

                            <AutoCompleteTextView
                                android:id="@+id/autoVariety"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="8dp"
                                android:backgroundTint="#2E7D32"
                                android:hint="Select variety..."
                                android:inputType="text"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:textColor="#263238"
                                android:textColorHint="#90A4AE"
                                android:enabled="false"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- ================================================= -->
                    <!-- SELECTION STATUS -->
                    <!-- ================================================= -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardSelectionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E8F5E9">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvSelectionIcon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:gravity="center"
                                android:text="✓"
                                android:textColor="#2E7D32"
                                android:textSize="20sp"
                                android:textStyle="bold"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">

                                <TextView
                                    android:id="@+id/tvSelectionStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Select a variety to continue"
                                    android:textColor="#2E7D32"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/tvSelectionDetails"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Farm and flower type are required"
                                    android:textColor="#558B5A"
                                    android:textSize="12sp"/>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- ================================================= -->
                    <!-- START BUTTON -->
                    <!-- ================================================= -->

                    <Button
                        android:id="@+id/btnStartRejections"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="#2E7D32"
                        android:text="Start Rejection"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- STAGE 2 : REJECTION ENTRY -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/rejectionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Selected variety banner -->

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:id="@+id/tvSelectedVariety"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Summer Beauty"
                                android:textColor="#263238"
                                android:textSize="21sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvSelectedFarmType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Chui  •  Spray"
                                android:textColor="#78909C"
                                android:textSize="13sp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Enter rejected stems"
                                    android:textColor="#607D8B"
                                    android:textSize="13sp"/>

                                <TextView
                                    android:id="@+id/tvTotalRejected"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 stems"
                                    android:textColor="#2E7D32"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- ================================================= -->
                    <!-- DISEASES -->
                    <!-- ================================================= -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardDiseases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:gravity="center"
                                    android:text="✦"
                                    android:textColor="#C62828"
                                    android:textSize="18sp"
                                    android:background="#FFEBEE"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginStart="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Diseases"
                                        android:textColor="#263238"
                                        android:textSize="17sp"
                                        android:textStyle="bold"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Disease-related rejection"
                                        android:textColor="#90A4AE"
                                        android:textSize="12sp"/>

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/containerDiseases"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- ================================================= -->
                    <!-- PEST -->
                    <!-- ================================================= -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:gravity="center"
                                    android:text="◆"
                                    android:textColor="#EF6C00"
                                    android:textSize="17sp"
                                    android:background="#FFF3E0"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginStart="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Pest"
                                        android:textColor="#263238"
                                        android:textSize="17sp"
                                        android:textStyle="bold"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Pest and insect-related rejection"
                                        android:textColor="#90A4AE"
                                        android:textSize="12sp"/>

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/containerPest"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- ================================================= -->
                    <!-- OTHER QUALITY -->
                    <!-- ================================================= -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardQuality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:gravity="center"
                                    android:text="✓"
                                    android:textColor="#1565C0"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:background="#E3F2FD"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:layout_marginStart="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Other Quality Issues"
                                        android:textColor="#263238"
                                        android:textSize="17sp"
                                        android:textStyle="bold"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="General quality and handling issues"
                                        android:textColor="#90A4AE"
                                        android:textSize="12sp"/>

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/containerQuality"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- Continue -->

                    <Button
                        android:id="@+id/btnRejectionsNext"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="#2E7D32"
                        android:text="Continue"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- STAGE 3 : COMMENTS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/commentsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Additional notes"
                        android:textColor="#263238"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Add any observations or information about this rejection."
                        android:textColor="#718096"
                        android:textSize="14sp"/>


                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <EditText
                            android:id="@+id/edtComments"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:gravity="top|start"
                            android:hint="Enter comments or observations..."
                            android:inputType="textMultiLine"
                            android:padding="16dp"
                            android:textColor="#263238"
                            android:textColorHint="#90A4AE"
                            android:backgroundTint="#2E7D32"/>

                    </androidx.cardview.widget.CardView>


                    <!-- Summary preview -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCommentsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REJECTION TOTAL"
                                android:textColor="#78909C"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"/>

                            <TextView
                                android:id="@+id/tvCommentsTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="0 stems"
                                android:textColor="#2E7D32"
                                android:textSize="25sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <Button
                        android:id="@+id/btnCommentsNext"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="#2E7D32"
                        android:text="Review &amp; Submit"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- STAGE 4 : SUMMARY -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/summarySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Review rejection"
                        android:textColor="#263238"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Confirm the details before submitting."
                        android:textColor="#718096"
                        android:textSize="14sp"/>


                    <!-- Selected variety -->

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:id="@+id/tvSummaryVariety"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Summer Beauty"
                                android:textColor="#263238"
                                android:textSize="20sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvSummaryFarmType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Chui  •  Spray"
                                android:textColor="#78909C"
                                android:textSize="13sp"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- Dynamic summary -->

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REJECTION BREAKDOWN"
                                android:textColor="#78909C"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"/>

                            <LinearLayout
                                android:id="@+id/containerSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical"/>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="14dp"
                                android:background="#ECEFF1"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="TOTAL REJECTED"
                                    android:textColor="#607D8B"
                                    android:textSize="12sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/tvSummaryTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 stems"
                                    android:textColor="#2E7D32"
                                    android:textSize="20sp"
                                    android:textStyle="bold"/>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- Comments -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardSummaryComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COMMENTS"
                                android:textColor="#78909C"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"/>

                            <TextView
                                android:id="@+id/tvSummaryComments"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="No comments added."
                                android:textColor="#455A64"
                                android:textSize="14sp"/>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                    <!-- Submit -->

                    <Button
                        android:id="@+id/btnSubmitAll"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="#1B5E20"
                        android:text="Submit Rejection"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <!-- ===================================================== -->
        <!-- BOTTOM STATUS BAR -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/bottomStatusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="#FFFFFF">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#4CAF50"/>

            <TextView
                android:id="@+id/tvBottomStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Ready"
                android:textColor="#607D8B"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvBottomTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 stems"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
