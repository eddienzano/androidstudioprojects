<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="16dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/header_gradient"
        android:layout_marginBottom="12dp">

        <TextView
            android:text="BOX SCAN OUT"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" android:layout_height="30dp" android:layout_width="250dp"/>
    </LinearLayout>

    <!-- DASHBOARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvValid"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="@drawable/input_box"
            android:textColor="#2E7D32"/>

        <TextView
            android:id="@+id/tvDuplicate"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="@drawable/input_box"
            android:textColor="#C62828"/>

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="@drawable/input_box"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- RESET -->
    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Reset Session"
        android:backgroundTint="#FF5252"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <!-- INPUT -->
    <EditText
        android:id="@+id/inputScan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Scan QR code"
        android:background="@drawable/input_box"
        android:padding="16dp"
        android:textSize="18sp"
        android:singleLine="true"/>

    <!-- CAMERA -->
    <Button
        android:id="@+id/btnCameraScan"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="📷 Scan Camera"
        android:background="@drawable/primary_button"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

    <!-- SYNC BUTTON -->
    <Button
        android:id="@+id/btnSync"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="SYNC (0)"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp"/>

</LinearLayout>