<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center"
        android:background="#2E7D32"
        android:layout_marginBottom="10dp">

        <TextView
            android:text="Summers Stock Take"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>
    </LinearLayout>

    <!-- DASHBOARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvValid"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="#E8F5E9"
            android:textColor="#2E7D32"/>

        <TextView
            android:id="@+id/tvDuplicate"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="#FFEBEE"
            android:textColor="#C62828"/>

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="#ECEFF1"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- INPUT -->
    <EditText
        android:id="@+id/inputScan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Scan QR Code"
        android:padding="15dp"
        android:background="#FFFFFF"
        android:textSize="18sp"/>

    <!-- CAMERA -->
    <Button
        android:id="@+id/btnCameraScan"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Scan Camera"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

    <!-- SEND -->
    <Button
        android:id="@+id/btnSendDb"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Send to Server"
        android:backgroundTint="#1565C0"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvSyncStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pending: 0 | Synced: 0"
        android:textStyle="bold"
        android:padding="10dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerScans"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>