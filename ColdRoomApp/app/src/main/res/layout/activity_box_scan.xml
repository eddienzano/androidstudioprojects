<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/scanBtn"
        android:text="Scan with Camera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/inputScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Scan (Honeywell)"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/txtResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:paddingTop="20dp"/>

    <TextView
        android:id="@+id/txtSyncStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Checking..."
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingTop="10dp"/>

    <TextView
        android:id="@+id/txtPendingCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pending: 0"
        android:textSize="16sp"
        android:paddingBottom="10dp"/>

    <Button
        android:id="@+id/btnSync"
        android:text="Sync Pending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>

</LinearLayout>