<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="20dp">

    ```
    <!-- =========================================================
         HEADER
         ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/header_gradient"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Graded Stock Take"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coldroom Scanner"
            android:textSize="12sp"
            android:textColor="#E8F5E9"
            android:layout_marginTop="2dp" />

    </LinearLayout>


    <!-- =========================================================
         DASHBOARD
         ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">


        <!-- VALID -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/input_box">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VALID"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvValid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>


        <!-- DUPLICATE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/input_box">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DUPLICATE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvDuplicate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#F57C00" />

        </LinearLayout>


        <!-- NOT FOUND -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/input_box">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOT FOUND"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvNotFound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#C62828" />

        </LinearLayout>


        <!-- TOTAL -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/input_box">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#000000" />

        </LinearLayout>


    </LinearLayout>


    <!-- =========================================================
         RESET
         ========================================================= -->

    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Reset Counter"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#FF5252"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />


    <!-- =========================================================
         QR INPUT
         ========================================================= -->

    <EditText
        android:id="@+id/inputScan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Scan QR code"
        android:singleLine="true"
        android:inputType="text"
        android:background="@drawable/input_box"
        android:padding="16dp"
        android:textSize="17sp"
        android:layout_marginBottom="8dp" />


    <!-- =========================================================
         CAMERA
         ========================================================= -->

    <Button
        android:id="@+id/btnCameraScan"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="📷  Scan Camera"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/primary_button"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />


    <!-- =========================================================
         SYNC
         ========================================================= -->

    <Button
        android:id="@+id/btnSendDb"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="↻  Sync Scans to Database"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp" />


    <!-- =========================================================
         RECENT SCANS HEADER
         ========================================================= -->

    <TextView
        android:id="@+id/tvRecentHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recent Scans"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:paddingBottom="5dp" />


    <!-- =========================================================
         RECENT SCANS
         ========================================================= -->

    <ScrollView
        android:id="@+id/recentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#333333"
            android:lineSpacingExtra="5dp" />

    </ScrollView>
    ```

</LinearLayout>
