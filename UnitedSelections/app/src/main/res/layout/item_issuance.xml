<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- QR -->
        <TextView
            android:id="@+id/txtQR"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#222" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

        <!-- 🔥 NEW DETAILS -->
        <TextView
            android:id="@+id/txtDetails"
            android:layout_marginTop="6dp"
            android:textColor="#333"
            android:textSize="14sp" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

        <!-- TIMES -->
        <TextView
            android:id="@+id/txtTimes"
            android:layout_marginTop="6dp"
            android:textColor="#555" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

        <!-- DURATION -->
        <TextView
            android:id="@+id/txtDuration"
            android:layout_marginTop="4dp"
            android:textColor="#000" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

        <!-- STATUS -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            android:textSize="14sp" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>