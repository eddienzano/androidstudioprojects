<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="3dp">

    <TextView
        android:id="@+id/txtTitle"
        android:text="Variety"
        android:textSize="16sp"
        android:textStyle="bold" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

    <TextView
        android:id="@+id/txtSub"
        android:text="Greenhouse"
        android:textSize="13sp"
        android:textColor="#666" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

    <TextView
        android:id="@+id/txtQty"
        android:text="0"
        android:textSize="18sp"
        android:textColor="#4CAF50"
        android:textStyle="bold" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
</LinearLayout>