<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Variety"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- PEDIGREE -->

        <EditText
            android:id="@+id/etPedigree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pedigree Item"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textCapCharacters" />

        <!-- DESCRIPTION -->

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textCapWords" />

        <!-- SEQUENCE -->

        <EditText
            android:id="@+id/etSeq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sequence (optional)"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- VARIETY TYPE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Variety Type"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spVarietyType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- GREENHOUSE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Greenhouse"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spGreenhouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- SAVE BUTTON -->

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Variety"
            android:padding="14dp" />

    </LinearLayout>

</ScrollView>